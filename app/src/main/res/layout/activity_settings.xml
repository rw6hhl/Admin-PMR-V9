<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorback"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <Button
            android:id="@+id/btnToggleServer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/roundshapebtn"
            android:text="Настройки сервера"
            android:textColor="@color/colorButton"
            android:layout_marginBottom="16dp" />

        <LinearLayout
            android:id="@+id/layoutServerSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="MyMailIndex ="
                    android:textColor="@color/colortextabout"
                    android:textSize="18sp" />
                <EditText
                    android:id="@+id/editMailIndex"
                    android:layout_width="120dp"
                    android:layout_height="wrap_content"
                    android:backgroundTint="@color/colortextabout"
                    android:inputType="number"
                    android:textColor="@color/colortextabout"
                    android:textSize="18sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Priznak_pmr ="
                    android:textColor="@color/colortextabout"
                    android:textSize="18sp" />
                <EditText
                    android:id="@+id/editPriznak"
                    android:layout_width="120dp"
                    android:layout_height="wrap_content"
                    android:backgroundTint="@color/colortextabout"
                    android:inputType="number"
                    android:maxLength="5"
                    android:textColor="@color/colortextabout"
                    android:textSize="18sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="PORT_prm ="
                    android:textColor="@color/colortextabout"
                    android:textSize="18sp" />
                <EditText
                    android:id="@+id/editPortPrm"
                    android:layout_width="120dp"
                    android:layout_height="wrap_content"
                    android:backgroundTint="@color/colortextabout"
                    android:inputType="number"
                    android:textColor="@color/colortextabout"
                    android:textSize="18sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="PORT_prd ="
                    android:textColor="@color/colortextabout"
                    android:textSize="18sp" />
                <EditText
                    android:id="@+id/editPortPrd"
                    android:layout_width="120dp"
                    android:layout_height="wrap_content"
                    android:backgroundTint="@color/colortextabout"
                    android:inputType="number"
                    android:textColor="@color/colortextabout"
                    android:textSize="18sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="ip_server ="
                    android:textColor="@color/colortextabout"
                    android:textSize="18sp" />
                <EditText
                    android:id="@+id/editIp"
                    android:layout_width="150dp"
                    android:layout_height="wrap_content"
                    android:backgroundTint="@color/colortextabout"
                    android:inputType="text"
                    android:textColor="@color/colortextabout"
                    android:textSize="18sp" />
            </LinearLayout>

            <CheckBox
                android:id="@+id/cbPttLatch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Постоянная передача (двойной тап по PTT)"
                android:textColor="@color/colortextabout"
                android:checked="true"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="16dp" />

            <CheckBox
                android:id="@+id/cbShowListNames"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Показывать list.txt (имена в CALL)"
                android:textColor="@color/colortextabout"
                android:checked="false"
                android:layout_marginBottom="16dp" />

            <CheckBox
                android:id="@+id/cbAskPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Запрашивать пароль"
                android:textColor="@color/colortextabout"
                android:checked="true"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="16dp" />

            <CheckBox
                android:id="@+id/cbUsilMic"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Усилитель микрофона (onUsilMic)"
                android:textColor="@color/colortextabout"
                android:layout_marginTop="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="MicUsildouble ="
                    android:textColor="@color/colortextabout"
                    android:textSize="18sp" />
                <EditText
                    android:id="@+id/editUsilMic"
                    android:layout_width="120dp"
                    android:layout_height="wrap_content"
                    android:backgroundTint="@color/colortextabout"
                    android:inputType="numberDecimal"
                    android:textColor="@color/colortextabout"
                    android:textSize="18sp" />
            </LinearLayout>

            <CheckBox
                android:id="@+id/cbAgc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="АРУ (Динамическое усиление)"
                android:textColor="@color/colortextabout"
                android:layout_marginBottom="16dp" />

            <CheckBox
                android:id="@+id/cbUsilDin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Усилитель выхода (onUsilDin)"
                android:textColor="@color/colortextabout"
                android:layout_marginTop="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:layout_marginBottom="24dp"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="DinUsildouble ="
                    android:textColor="@color/colortextabout"
                    android:textSize="18sp" />
                <EditText
                    android:id="@+id/editUsilDin"
                    android:layout_width="120dp"
                    android:layout_height="wrap_content"
                    android:backgroundTint="@color/colortextabout"
                    android:inputType="numberDecimal"
                    android:textColor="@color/colortextabout"
                    android:textSize="18sp" />
            </LinearLayout>

        </LinearLayout>

        <CheckBox
            android:id="@+id/cbVerboseLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Вести подробный лог"
            android:textColor="@color/colortextabout"
            android:checked="true"
            android:visibility="gone"
            android:layout_marginBottom="8dp" />

        <CheckBox
            android:id="@+id/cbSoundEnabled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Звук кнопок (тон 1500 Гц)"
            android:textColor="@color/colortextabout"
            android:checked="false"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/btnCodecDialog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/roundshapebtn"
            android:text="Режим передачи"
            android:textColor="@color/colorButton" />

        <Button
            android:id="@+id/btnChanList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/roundshapebtn"
            android:text="Список"
            android:textColor="@color/colorButton"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnLoadList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/roundshapebtn"
            android:text="ЗАГРУЗИТЬ list.txt"
            android:textColor="@color/colorButton" />

        <Button
            android:id="@+id/btnLogs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/roundshapebtn"
            android:text="Логи"
            android:textColor="@color/colorButton"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnSaveSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/roundshapebtn"
            android:text="СОХРАНИТЬ И ВЫЙТИ"
            android:textColor="@color/colorButton" />
    </LinearLayout>
</ScrollView>